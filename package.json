{
  "name": "cryptoai",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --filter @cryptoai/contracts --filter @cryptoai/config --filter @cryptoai/database --if-present build && pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./packages/*\" --if-present build && pnpm -r --filter \"./apps/*\" --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @cryptoai/database db:generate",
    "db:migrate": "pnpm --filter @cryptoai/database db:migrate",
    "db:seed": "pnpm --filter @cryptoai/database db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  }
}
