generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String?
  role         Role         @default(OWNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  sessions     Session[]

  @@unique([role])
}

model RiskProfile {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id])
  maxPortfolioExposurePercent  Decimal  @db.Decimal(5, 2)
  maxAssetExposurePercent      Decimal  @db.Decimal(5, 2)
  maxDailyLossPercent          Decimal  @db.Decimal(5, 2)
  maxDrawdownPercent           Decimal  @db.Decimal(5, 2)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel
  type      String
  message   String
  metadata  Json?
  createdAt DateTime         @default(now())
}

enum SystemEventLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model AuthAuditEvent {
  id        String   @id @default(cuid())
  event     String
  username  String?
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Asset {
  id         String   @id @default(cuid())
  symbol     String   @unique
  baseAsset  String
  quoteAsset String
  name       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  candles    PriceCandle[]
  snapshots  MarketSnapshot[]
}

model PriceCandle {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  openTime    DateTime
  closeTime   DateTime
  open        Decimal  @db.Decimal(24, 8)
  high        Decimal  @db.Decimal(24, 8)
  low         Decimal  @db.Decimal(24, 8)
  close       Decimal  @db.Decimal(24, 8)
  volume      Decimal  @db.Decimal(24, 8)
  quoteVolume Decimal  @db.Decimal(30, 8)
  trades      Int
  interval    String   @default("15m")
  createdAt   DateTime @default(now())

  @@unique([assetId, openTime, interval])
  @@index([assetId, openTime])
}

model MarketSnapshot {
  id              String   @id @default(cuid())
  assetId         String
  asset           Asset    @relation(fields: [assetId], references: [id])
  price           Decimal  @db.Decimal(24, 8)
  change24h       Decimal? @db.Decimal(12, 4)
  volume24h       Decimal? @db.Decimal(30, 8)
  high24h         Decimal? @db.Decimal(24, 8)
  low24h          Decimal? @db.Decimal(24, 8)
  collectedAt     DateTime @default(now())
  collectionRunId String?
  collectionRun   DataCollectionRun? @relation(fields: [collectionRunId], references: [id])

  @@unique([assetId, collectedAt])
}

model DataCollectionRun {
  id        String           @id @default(cuid())
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  status    String           @default("RUNNING")
  provider  String
  error     String?
  snapshots MarketSnapshot[]
}

// --- Phase 2: Quantitative & Risk Engine ---

model KillSwitch {
  id        String   @id @default(cuid())
  active    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskDecision {
  id              String   @id @default(cuid())
  status          String   // APPROVE | BLOCK
  ruleCode        String
  reason          String
  proposalJson    Json
  observedValue   Decimal? @db.Decimal(24, 8)
  configuredLimit Decimal? @db.Decimal(24, 8)
  positionSize    Decimal? @db.Decimal(24, 8)
  stopLoss        Decimal? @db.Decimal(24, 8)
  idempotencyKey  String   @unique
  asset           String
  createdAt       DateTime @default(now())
}
