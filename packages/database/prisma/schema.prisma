generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String?
  role         Role         @default(OWNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  sessions     Session[]

  @@unique([role])
}

model RiskProfile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id])
  maxPortfolioExposurePercent Decimal  @db.Decimal(5, 2)
  maxAssetExposurePercent     Decimal  @db.Decimal(5, 2)
  maxDailyLossPercent         Decimal  @db.Decimal(5, 2)
  maxDrawdownPercent          Decimal  @db.Decimal(5, 2)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel
  type      String
  message   String
  metadata  Json?
  createdAt DateTime         @default(now())
}

enum SystemEventLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model AuthAuditEvent {
  id        String   @id @default(cuid())
  event     String
  username  String?
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Asset {
  id                 String           @id @default(cuid())
  symbol             String           @unique
  baseAsset          String
  quoteAsset         String
  name               String
  active             Boolean          @default(true)
  isPinned           Boolean          @default(false)
  isExcluded         Boolean          @default(false)
  whitelist          Boolean          @default(false)
  exclusionReason    String?
  dataAvailable      Boolean          @default(true)
  lastSeenAt         DateTime?
  lastVolume24hUsd   Decimal?         @db.Decimal(30, 8)
  lastMarketCapUsd   Decimal?         @db.Decimal(30, 8)
  lastUniverseVersion String?
  maxCapitalUsd      Decimal?         @db.Decimal(24, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candles            PriceCandle[]
  snapshots          MarketSnapshot[]

  @@index([active, isExcluded, isPinned])
  @@index([lastSeenAt])
}

model PriceCandle {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  openTime    DateTime
  closeTime   DateTime
  open        Decimal  @db.Decimal(24, 8)
  high        Decimal  @db.Decimal(24, 8)
  low         Decimal  @db.Decimal(24, 8)
  close       Decimal  @db.Decimal(24, 8)
  volume      Decimal  @db.Decimal(24, 8)
  quoteVolume Decimal  @db.Decimal(30, 8)
  trades      Int
  interval    String   @default("15m")
  createdAt   DateTime @default(now())

  @@unique([assetId, openTime, interval])
  @@index([assetId, openTime])
}

model MarketSnapshot {
  id              String             @id @default(cuid())
  assetId         String
  asset           Asset              @relation(fields: [assetId], references: [id])
  price           Decimal            @db.Decimal(24, 8)
  change24h       Decimal?           @db.Decimal(12, 4)
  volume24h       Decimal?           @db.Decimal(30, 8)
  high24h         Decimal?           @db.Decimal(24, 8)
  low24h          Decimal?           @db.Decimal(24, 8)
  collectedAt     DateTime           @default(now())
  collectionRunId String?
  collectionRun   DataCollectionRun? @relation(fields: [collectionRunId], references: [id])

  @@unique([assetId, collectedAt])
}

model DataCollectionRun {
  id        String           @id @default(cuid())
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  status    String           @default("RUNNING")
  provider  String
  error     String?
  snapshots MarketSnapshot[]
}

// --- Phase 2: Quantitative & Risk Engine ---

model KillSwitch {
  id        String   @id @default(cuid())
  active    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskDecision {
  id              String   @id @default(cuid())
  status          String // APPROVE | BLOCK
  ruleCode        String
  reason          String
  proposalJson    Json
  observedValue   Decimal? @db.Decimal(24, 8)
  configuredLimit Decimal? @db.Decimal(24, 8)
  positionSize    Decimal? @db.Decimal(24, 8)
  stopLoss        Decimal? @db.Decimal(24, 8)
  idempotencyKey  String   @unique
  asset           String
  createdAt       DateTime @default(now())
}

// --- Phase 5: Memory & Evaluation ---

model StoredAgentReport {
  id                 String   @id @default(cuid())
  runId              String   @unique
  agentId            String
  agentVersion       String
  promptVersion      String
  requestedModel     String
  actualModel        String?
  asset              String
  horizon            String // SHORT | MEDIUM | LONG
  signal             String? // BUY | SELL | HOLD | WAIT | null
  score              Decimal  @db.Decimal(4, 2)
  confidence         Decimal  @db.Decimal(4, 2)
  dataQuality        Decimal  @db.Decimal(4, 2)
  reasoning          Json
  supportingEvidence Json
  opposingEvidence   Json
  sourceIds          String[]
  promptTokens       Int
  completionTokens   Int
  latencyMs          Int
  estimatedCostUsd   Decimal  @db.Decimal(12, 6)
  status             String // VALID | UNAVAILABLE | INVALID
  createdAt          DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([asset, createdAt])
  @@index([createdAt])
}

model StoredTradeProposal {
  id                     String    @id @default(cuid())
  runId                  String    @unique
  asset                  String
  action                 String? // BUY | SELL | HOLD | WAIT | null
  confidence             Decimal   @db.Decimal(4, 2)
  suggestedRiskFraction  Decimal?  @db.Decimal(4, 2)
  rationale              Json
  reportIds              String[]
  invalidationConditions Json
  expiresAt              DateTime?
  status                 String // VALID | NO_ACTION | UNAVAILABLE | INVALID | AMBIGUOUS
  decisionGateResult     String? // APPROVE | BLOCK | MANUAL_REVIEW (if processed)
  riskDecisionId         String? // FK to RiskDecision if one was produced
  managerAgentVersion    String
  managerPromptVersion   String
  requestedModel         String
  actualModel            String?
  promptTokens           Int
  completionTokens       Int
  latencyMs              Int
  estimatedCostUsd       Decimal   @db.Decimal(12, 6)
  createdAt              DateTime  @default(now())

  @@index([asset, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// --- Phase 7: Paper Trading & Backtesting ---

model PaperBalance {
  id           String   @id @default(cuid())
  singletonKey String   @unique @default("PAPER")
  quote        Decimal  @db.Decimal(24, 2) // USDT balance
  peakValue    Decimal  @db.Decimal(24, 2)
  dailyPnl     Decimal  @db.Decimal(24, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PaperOrder {
  id              String    @id @default(cuid())
  orderId         String    @unique
  executionKey    String?   @unique
  asset           String
  side            String // BUY | SELL
  type            String // MARKET | LIMIT
  quantity        Decimal   @db.Decimal(24, 8)
  price           Decimal   @db.Decimal(24, 8)
  commission      Decimal   @db.Decimal(24, 8)
  slippagePercent Decimal   @db.Decimal(8, 4)
  status          String // PENDING | FILLED | CANCELLED | REJECTED
  proposalRunId   String?
  riskDecisionId  String?
  backtestRunId   String?
  executedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([asset, createdAt])
  @@index([status, createdAt])
  @@index([backtestRunId])
}

model PaperPosition {
  id            String    @id @default(cuid())
  asset         String
  side          String // LONG | SHORT
  quantity      Decimal   @db.Decimal(24, 8)
  entryPrice    Decimal   @db.Decimal(24, 8)
  currentPrice  Decimal   @db.Decimal(24, 8)
  unrealizedPnl Decimal   @db.Decimal(24, 8)
  stopLoss      Decimal?  @db.Decimal(24, 8)
  takeProfit    Decimal?  @db.Decimal(24, 8)
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  status        String    @default("OPEN") // OPEN | CLOSED

  @@index([asset])
  @@index([status])
}

model BacktestRun {
  id             String   @id @default(cuid())
  strategy       String // BUY_AND_HOLD | QUANTITATIVE | HYBRID_AI
  asset          String
  startDate      DateTime
  endDate        DateTime
  initialQuote   Decimal  @db.Decimal(24, 2)
  finalQuote     Decimal  @db.Decimal(24, 2)
  totalReturn    Decimal  @db.Decimal(8, 4)
  maxDrawdown    Decimal  @db.Decimal(8, 4)
  sharpeRatio    Decimal? @db.Decimal(8, 4)
  sortinoRatio   Decimal? @db.Decimal(8, 4)
  totalTrades    Int
  winRate        Decimal? @db.Decimal(6, 4)
  avgProfit      Decimal? @db.Decimal(24, 8)
  avgLoss        Decimal? @db.Decimal(24, 8)
  commissionCost Decimal  @db.Decimal(24, 8)
  slippageCost   Decimal  @db.Decimal(24, 8)
  aiCostUsd      Decimal  @db.Decimal(12, 6)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([strategy, createdAt])
  @@index([asset, createdAt])
}

// --- v1.4: Trading Plan & Dashboard 2.0 ---

model TradingPlan {
  id                    String   @id @default(cuid())
  proposalRunId         String   @unique
  strategy              String // SCALPING | INTRADAY | SWING | POSITION
  expectedDuration      String
  expectedProfitPercent Decimal  @db.Decimal(8, 4)
  expectedRiskPercent   Decimal  @db.Decimal(8, 4)
  confidence            Decimal  @db.Decimal(4, 2)
  suggestedEntry        Decimal  @db.Decimal(24, 8)
  suggestedTakeProfit   Decimal  @db.Decimal(24, 8)
  suggestedStopLoss     Decimal  @db.Decimal(24, 8)
  urgency               String // LOW | MEDIUM | HIGH
  reasons               Json
  createdAt             DateTime @default(now())

  @@index([proposalRunId])
}

model MarketOpportunityScore {
  id                   String   @id @default(cuid())
  asset                String
  score                Int // 0-100 legacy opportunity intensity
  classification       String // IGNORE | MONITORING | QUANTITATIVE_ANALYSIS | AI_ANALYSIS | MAX_PRIORITY
  components           Json
  direction            String?
  opportunityIntensity Float?
  directionScore       Float?
  expectedMove         Float?
  expectedRisk         Float?
  estimatedCosts       Json?
  netEdge              Float?
  horizonCandles       Int?
  formulaVersion       String?
  featureVersion       String?
  features             Json?
  evaluatedAt          DateTime @default(now())

  @@unique([asset, evaluatedAt])
  @@index([asset, evaluatedAt])
  @@index([evaluatedAt])
  @@index([netEdge, evaluatedAt])
}

model AIDecisionMemory {
  id                   String   @id @default(cuid())
  proposalRunId        String   @unique
  asset                String
  action               String // BUY | SELL
  strategy             String? // SCALPING | INTRADAY | SWING | POSITION
  entryPrice           Decimal  @db.Decimal(24, 8)
  indicatorsJson       Json
  modelUsed            String
  promptVersion        String
  confidenceAtDecision Decimal  @db.Decimal(4, 2)
  decidedAt            DateTime
  outcomes             Json // [MemoryOutcome]
  finalResult          Decimal? @db.Decimal(8, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([asset, decidedAt])
  @@index([modelUsed, createdAt])
  @@index([proposalRunId])
}

model OperatingModeConfig {
  id                String   @id @default(cuid())
  mode              String   @default("PAPER") // PAPER | ASSISTED | AUTONOMOUS
  autoApprovalRules Json // AutoApprovalRule[]
  updatedAt         DateTime @updatedAt
}

model EquitySnapshot {
  id        String   @id @default(cuid())
  equity    Decimal  @db.Decimal(24, 2)
  timestamp DateTime @default(now())

  @@index([timestamp])
}

// --- v1.5: Market Scanner Configuration ---

model ScannerConfig {
  id                      String   @id @default(cuid())
  maxAssetsToScan         Int      @default(100)
  maxAssetsForQuant       Int      @default(10)
  maxAssetsForAI          Int      @default(5)
  minScoreForAI           Int      @default(60) // 0-100
  scannerFrequencyMinutes Int      @default(1) // scheduler runs every 60 seconds; retained for UI compatibility
  minVolume24hUsd         Decimal  @default(1000000) @db.Decimal(20, 2)
  minMarketCapUsd         Decimal  @default(10000000) @db.Decimal(20, 2)
  universeRefreshMinutes  Int      @default(60)
  cooldownAfterOpenMinutes Int     @default(60)
  cooldownAfterCloseMinutes Int   @default(60)
  reevaluationDeltaPercent Decimal @default(3) @db.Decimal(8, 4)
  maxDailyAiCalls         Int      @default(20)
  maxDailyAiCostUsd       Decimal  @default(1) @db.Decimal(12, 6)
  updatedAt               DateTime @updatedAt
}

model AssetUniverseVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  source      String
  payloadHash String
  symbols     Json
  fetchedAt   DateTime
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([fetchedAt])
}

model AssetEvaluationState {
  id             String   @id @default(cuid())
  symbol         String   @unique
  featureHash    String
  evaluatedAt    DateTime
  score          Float?
  netEdge        Float?
  direction      String?
  lastAiEnqueuedAt DateTime?
  lastProposalKey String?
  updatedAt      DateTime @updatedAt

  @@index([evaluatedAt])
}

model AssetCooldown {
  id              String   @id @default(cuid())
  symbol          String   @unique
  reason          String
  cooldownUntil   DateTime
  openedAt        DateTime?
  closedAt        DateTime?
  lastDecisionKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([cooldownUntil])
}

model ScannerAiBudget {
  id             String   @id @default(cuid())
  budgetDay      DateTime @unique
  callsReserved  Int      @default(0)
  costReservedUsd Decimal @default(0) @db.Decimal(12, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([budgetDay])
}

model PerformanceSnapshot {
  id                 String   @id @default(cuid())
  realizedPnl        Decimal  @default(0) @db.Decimal(24, 8)
  unrealizedPnl      Decimal  @default(0) @db.Decimal(24, 8)
  dailyRealizedPnl   Decimal  @default(0) @db.Decimal(24, 8)
  dailyUnrealizedPnl Decimal  @default(0) @db.Decimal(24, 8)
  cumulativeNetPnl   Decimal  @default(0) @db.Decimal(24, 8)
  equity             Decimal  @default(0) @db.Decimal(24, 8)
  recordedAt         DateTime @default(now())

  @@index([recordedAt])
}

model ConfigurationSnapshot {
  id            String   @id @default(cuid())
  kind          String
  version       String
  payload       Json
  payloadHash   String
  effectiveFrom DateTime @default(now())
  createdBy     String   @default("SYSTEM")
  createdAt     DateTime @default(now())

  @@unique([kind, version])
  @@unique([kind, payloadHash])
  @@index([kind, createdAt])
}

model DecisionAudit {
  id                       String   @id @default(cuid())
  decisionKey              String   @unique
  proposalRunId            String?
  asset                    String
  action                   String?
  decisionStatus           String
  marketInput              Json
  quantitativeFeatures     Json
  agentReportIds           String[]
  proposalJson             Json
  decisionGateResult       String?
  riskDecisionId           String?
  orderId                  String?
  configurationSnapshotIds String[]
  promptVersion            String?
  requestedModel           String?
  actualModel              String?
  outcomeStatus            String   @default("PENDING")
  migrationSafe            Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([asset, createdAt])
  @@index([outcomeStatus, createdAt])
}

model OutcomeLedger {
  id              String   @id @default(cuid())
  decisionAuditId String
  proposalRunId   String?
  orderId         String?
  checkpoint      String
  referencePrice  Decimal? @db.Decimal(24, 8)
  entryPrice      Decimal? @db.Decimal(24, 8)
  exitPrice       Decimal? @db.Decimal(24, 8)
  realizedPnl     Decimal  @default(0) @db.Decimal(24, 8)
  unrealizedPnl   Decimal  @default(0) @db.Decimal(24, 8)
  grossPnl        Decimal  @default(0) @db.Decimal(24, 8)
  fee             Decimal  @default(0) @db.Decimal(24, 8)
  slippage        Decimal  @default(0) @db.Decimal(24, 8)
  netPnl          Decimal  @default(0) @db.Decimal(24, 8)
  wasCorrect      Boolean?
  recordedAt      DateTime @default(now())

  @@unique([decisionAuditId, checkpoint])
  @@index([proposalRunId, recordedAt])
  @@index([checkpoint, recordedAt])
}
