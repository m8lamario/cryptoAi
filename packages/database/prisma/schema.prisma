generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String?
  role         Role         @default(OWNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  riskProfile  RiskProfile?
  sessions     Session[]

  @@unique([role])
}

model RiskProfile {
  id                           String   @id @default(cuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id])
  maxPortfolioExposurePercent  Decimal  @db.Decimal(5, 2)
  maxAssetExposurePercent      Decimal  @db.Decimal(5, 2)
  maxDailyLossPercent          Decimal  @db.Decimal(5, 2)
  maxDrawdownPercent           Decimal  @db.Decimal(5, 2)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model SystemEvent {
  id        String           @id @default(cuid())
  level     SystemEventLevel
  type      String
  message   String
  metadata  Json?
  createdAt DateTime         @default(now())
}

enum SystemEventLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model AuthAuditEvent {
  id        String   @id @default(cuid())
  event     String
  username  String?
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
}
