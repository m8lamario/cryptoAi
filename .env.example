# Environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://cryptoai:changeme@localhost:5432/cryptoai

# Redis connection string
REDIS_URL=redis://localhost:6379

# Express API port
API_PORT=4000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Single owner username (no public registration)
OWNER_USERNAME=owner

# -----------------------------------------------------------------------
# Auth settings (Phase 0B)
# -----------------------------------------------------------------------

# Origin allowed for browser-originated auth requests (CSRF protection)
APP_ORIGIN=http://localhost:3000

# Session lifetime in seconds (default: 86400 = 24h)
SESSION_TTL_SECONDS=86400

# Set to true when serving over HTTPS (production/VPN). false for localhost.
SESSION_COOKIE_SECURE=false

# Login rate limit: max attempts per IP per window
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Base URL of the API as seen from the Next.js server (server-side only)
API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------
# OWNER_PASSWORD — set out-of-band, never commit to source control.
# Required only on first seed run (or when resetting a null passwordHash).
# Run:  OWNER_PASSWORD=<your-strong-password> pnpm db:seed
# After the hash is stored you may unset this variable.
# -----------------------------------------------------------------------
# OWNER_PASSWORD=

# -----------------------------------------------------------------------
# AI Gateway — OpenRouter (Phase 2B)
# -----------------------------------------------------------------------

# OpenRouter API key (server-side only)
# OPENROUTER_API_KEY=

# Optional: override default OpenRouter base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: app title sent in X-Title header
# OPENROUTER_APP_TITLE=cryptoai

# Optional: HTTP referer for OpenRouter ranking
# OPENROUTER_HTTP_REFERER=https://github.com/your-org/cryptoai

# Default model (if not specified per-agent)
# OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-pro

# Daily budget cap in USD (0 = disabled)
# AI_DAILY_BUDGET_USD=1.00

# Monthly budget cap in USD (0 = disabled)
# AI_MONTHLY_BUDGET_USD=20.00

# Circuit breaker: failures before opening (default: 5)
# AI_CIRCUIT_FAILURE_THRESHOLD=5

# Circuit breaker: ms before trying half-open (default: 60000 = 1 min)
# AI_CIRCUIT_RESET_TIMEOUT_MS=60000

# Circuit breaker: max calls in half-open state (default: 1)
# AI_CIRCUIT_HALF_OPEN_MAX_CALLS=1

# Default timeout per AI call in ms (default: 60000 = 60s)
# AI_DEFAULT_TIMEOUT_MS=60000

# Default max retries on transient errors (default: 2)
# AI_DEFAULT_MAX_RETRIES=2

# Default temperature (0-2, default: 0.3)
# AI_DEFAULT_TEMPERATURE=0.3

# Default max output tokens (default: 1500)
# AI_DEFAULT_MAX_TOKENS=1500
